## Paladin Retribution profile

## Precombat
actions.precombat+=/retribution_aura,if=!up&settings.maintain_aura&assigned_aura.retribution_aura
actions.precombat+=/concentration_aura,if=!up&settings.maintain_aura&assigned_aura.concentration_aura
actions.precombat+=/crusader_aura,if=!up&settings.maintain_aura&assigned_aura.crusader_aura
actions.precombat+=/devotion_aura,if=!up&settings.maintain_aura&assigned_aura.devotion_aura
actions.precombat+=/fire_resistance_aura,if=!up&settings.maintain_aura&assigned_aura.fire_resistance_aura
actions.precombat+=/frost_resistance_aura,if=!up&settings.maintain_aura&assigned_aura.frost_resistance_aura
actions.precombat+=/shadow_resistance_aura,if=!up&settings.maintain_aura&assigned_aura.shadow_resistance_aura
actions.precombat+=/blessing_of_kings,if=!up&settings.maintain_blessing&assigned_blessing.blessing_of_kings
actions.precombat+=/blessing_of_might,if=!up&settings.maintain_blessing&assigned_blessing.blessing_of_might
actions.precombat+=/blessing_of_sanctuary,if=!up&settings.maintain_blessing&assigned_blessing.blessing_of_sanctuary
actions.precombat+=/blessing_of_wisdom,if=!up&settings.maintain_blessing&assigned_blessing.blessing_of_wisdom
actions.precombat+=/seal_of_vengeance,if=buff.seal.remains<360
actions.precombat+=/potion,if=mana.percent<settings.divine_plea_threshold

## Default
actions+=/use_items
actions+=/potion
actions+=/crusader_strike,if=buff.formidable.up&buff.formidable.remains<2
actions+=/run_action_list,name=cleave,if=active_enemies>1
actions+=/run_action_list,name=execute,if=active_enemies=1&target.health.pct<20
actions+=/run_action_list,name=single

## Cleave
actions.cleave+=/seal_of_command,if=buff.seal.down
actions.cleave+=/avenging_wrath,if=((((target.time_to_die*0.9)-20)>action.avenging_wrath.cooldown)|(target.health.pct<=20))&(!buff.seal_of_vengeance.up|dot.holy_vengeance.stack>4)
actions.cleave+=/judgement_of_wisdom,if=mana.percent<(settings.judgement_of_wisdom_threshold*0.333333)
actions.cleave+=/crusader_strike,if=set_bonus.tier10ret_2pc=1
actions.cleave+=/consecration,if=!moving&!buff.active_consecration.up&active_enemies>2
actions.cleave+=/crusader_strike
actions.cleave+=/crusader_strike
actions.cleave+=/hammer_of_wrath
actions.cleave+=/consecration,if=!moving&!buff.active_consecration.up&mana.percent>(settings.judgement_of_wisdom_threshold*0.25)
actions.cleave+=/judgement_of_wisdom,if=mana.percent<(settings.judgement_of_wisdom_threshold*0.5)
actions.cleave+=/potion,if=mana.percent<(settings.divine_plea_threshold*0.5)
actions.cleave+=/holy_wrath,if=(target.is_demon|target.is_undead)&active_enemies>2&mana.percent>(settings.judgement_of_wisdom_threshold*0.555556)
actions.cleave+=/exorcism,if=buff.the_art_of_war.up&(cooldown.crusader_strike.remains<?cooldown.divine_storm.remains)>settings.primary_slack&mana.percent>(settings.judgement_of_wisdom_threshold*0.588235)
actions.cleave+=/judgement_of_wisdom,if=mana.percent<settings.judgement_of_wisdom_threshold
actions.cleave+=/judgement_of_light
actions.cleave+=/potion,if=mana.percent<settings.divine_plea_threshold
actions.cleave+=/holy_wrath,if=(target.is_demon|target.is_undead)&mana.percent>(settings.judgement_of_wisdom_threshold*0.588235)

## Execute
actions.execute+=/seal_of_vengeance,if=buff.seal.down
actions.execute+=/avenging_wrath,if=(!buff.seal_of_vengeance.up|dot.holy_vengeance.stack>4)
actions.execute+=/judgement_of_wisdom,if=mana.percent<(settings.judgement_of_wisdom_threshold*0.4)
actions.execute+=/hammer_of_wrath,if=set_bonus.tier10ret_2pc=0|!settings.highroll
actions.execute+=/judgement_of_wisdom,if=mana.percent<settings.judgement_of_wisdom_threshold
actions.execute+=/judgement_of_light
actions.execute+=/crusader_strike,if=set_bonus.tier10ret_2pc=1&settings.highroll
actions.execute+=/crusader_strike
actions.execute+=/crusader_strike,if=set_bonus.tier10ret_2pc=1
actions.execute+=/hammer_of_wrath,if=set_bonus.tier10ret_2pc=1&settings.highroll
actions.execute+=/consecration,if=!buff.active_consecration.up&target.time_to_die>4
actions.execute+=/crusader_strike
actions.execute+=/potion,if=mana.percent<(settings.divine_plea_threshold*0.5)
actions.execute+=/exorcism,if=buff.the_art_of_war.up&(next_primary_at<?cooldown.hammer_of_wrath.remains)>settings.primary_slack
actions.execute+=/potion,if=mana.percent<settings.divine_plea_threshold&(next_primary_at<?cooldown.hammer_of_wrath.remains)>settings.primary_slack
actions.execute+=/holy_wrath,if=(target.is_demon|target.is_undead)&(next_primary_at<?cooldown.hammer_of_wrath.remains)>settings.primary_slack&mana.percent>(settings.judgement_of_wisdom_threshold*0.714286)

## Single
actions.single+=/seal_of_vengeance,if=buff.seal.down
actions.single+=/avenging_wrath,if=((target.time_to_die*0.9-20)>action.avenging_wrath.cooldown)&(!buff.seal_of_vengeance.up|dot.holy_vengeance.stack>4)
actions.single+=/judgement_of_wisdom,if=mana.percent<settings.judgement_of_wisdom_threshold
actions.single+=/judgement_of_light
actions.single+=/crusader_strike,if=set_bonus.libram_of_three_truths&buff.formidable.count<5
actions.single+=/crusader_strike,if=set_bonus.tier10ret_2pc=1&settings.highroll
actions.single+=/crusader_strike
actions.single+=/crusader_strike
actions.single+=/potion,if=mana.percent<settings.divine_plea_threshold
actions.single+=/exorcism,if=(target.is_demon|target.is_undead)&buff.the_art_of_war.up&next_primary_at>settings.primary_slack&mana.percent>(settings.judgement_of_wisdom_threshold*0.25)
actions.single+=/consecration,if=!buff.active_consecration.up&next_primary_at>settings.primary_slack&mana.percent>(settings.judgement_of_wisdom_threshold*0.333333)
actions.single+=/exorcism,if=buff.the_art_of_war.up&next_primary_at>settings.primary_slack&mana.percent>(settings.judgement_of_wisdom_threshold*0.285714)
actions.single+=/holy_wrath,if=(target.is_demon|target.is_undead)&next_primary_at>settings.primary_slack&mana.percent>(settings.judgement_of_wisdom_threshold*0.714286)
actions.single+=/flash_of_light,if=settings.fol_on_aow&buff.the_art_of_war.up&next_primary_at>primary_slack&!buff.divine_plea.up&cooldown.exorcism.remains>6