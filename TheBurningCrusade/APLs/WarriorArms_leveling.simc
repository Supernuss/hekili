actions.precombat+=/battle_stance,if=buff.battle_stance.down
actions.precombat+=/battle_shout,if=buff.battle_shout.down
actions.precombat+=/bloodrage,if=rage.deficit>20
actions.precombat+=/charge,if=target.outside8

actions+=/battle_shout,if=buff.battle_shout.down
actions+=/bloodrage,if=rage.deficit>20
actions+=/run_action_list,name=aoe,if=active_enemies>1
actions+=/run_action_list,name=single

actions.single+=/overpower,if=target.health.pct>20&buff.overpower_ready.up&rage.current<settings.warrior_arms_overpower_rage_threshold
actions.single+=/execute,if=target.health.pct<=20&target.time_to_die>gcd.max
actions.single+=/mortal_strike
actions.single+=/whirlwind,if=cooldown.mortal_strike.remains>gcd.max|rage.current>=60
actions.single+=/slam,if=talent.improved_slam.rank>0&rage.current>=settings.warrior_arms_slam_min_rage&cooldown.mortal_strike.remains>=settings.warrior_arms_slam_msww_delay&cooldown.whirlwind.remains>=settings.warrior_arms_slam_msww_delay
actions.single+=/sunder_armor,if=debuff.sunder_armor.stack<5&rage.current>=15
actions.single+=/sunder_armor,if=debuff.sunder_armor.stack=5&debuff.sunder_armor.remains<3
actions.single+=/heroic_strike,use_off_gcd=true,if=rage.current>=settings.warrior_arms_hs_rage_threshold|rage.deficit<=20

actions.aoe+=/sweeping_strikes,if=talent.sweeping_strikes.rank>0&active_enemies>=2&rage.current>=45
actions.aoe+=/overpower,if=target.health.pct>20&buff.overpower_ready.up&rage.current<settings.warrior_arms_overpower_rage_threshold
actions.aoe+=/execute,if=target.health.pct<=20&target.time_to_die>gcd.max
actions.aoe+=/whirlwind
actions.aoe+=/mortal_strike
actions.aoe+=/slam,if=talent.improved_slam.rank>0&rage.current>=settings.warrior_arms_slam_min_rage&cooldown.mortal_strike.remains>=settings.warrior_arms_slam_msww_delay&cooldown.whirlwind.remains>=settings.warrior_arms_slam_msww_delay
actions.aoe+=/cleave,use_off_gcd=true,if=rage.current>=settings.warrior_arms_hs_rage_threshold-10
