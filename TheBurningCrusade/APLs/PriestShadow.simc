## Precombat
actions.precombat+=/shadowform,if=buff.shadowform.down
actions.precombat+=/divine_spirit,if=buff.divine_spirit.down&buff.prayer_of_spirit.down
actions.precombat+=/power_word_fortitude,if=buff.power_word_fortitude.down&buff.prayer_of_fortitude.down
actions.precombat+=/inner_fire,if=buff.inner_fire.stacks<10
actions.precombat+=/vampiric_embrace,if=!up
actions.precombat+=/potion

## Default
actions+=/use_items
actions+=/potion
# having shadowform in rotation bugs out
#actions+=/shadowform,if=!buff.shadowform.up
actions+=/run_action_list,name=cleave,if=active_enemies>1
actions+=/run_action_list,name=single

## Cleave
actions.cleave+=/mind_flay,if=active_enemies>=8
actions.cleave+=/devouring_plague,if=!dot.devouring_plague.remains
actions.cleave+=/mind_flay,cycle_targets=1,max_cycle_targets=7,interrupt_if=!buff.inner_focus.up&ticks>=2,if=!moving&(dot.shadow_word_pain.remains<1.5&dot.shadow_word_pain.remains>=action.mind_flay.tick_time+latency)
actions.cleave+=/shadowfiend,if=target.time_to_die>0
actions.cleave+=/vampiric_touch,cycle_targets=1,max_cycle_targets=7,if=dot.vampiric_touch.remains+latency<cast_time&target.time_to_die>=3
actions.cleave+=/shadow_word_pain,cycle_targets=1,max_cycle_targets=7,if=!ticking&((buff.shadow_weaving.stack=5&target.time_to_die>=75)|(buff.shadow_weaving.stack>=3&target.time_to_die<75))&target.time_to_die>=10
actions.cleave+=/mind_blast,if=target.time_to_die>=cast_time&(flay_over_blast|buff.replenishment.remains<3)
actions.cleave+=/inner_fire,if=!buff.inner_fire.up&target.time_to_die>=10
actions.cleave+=/vampiric_embrace,if=!up&target.time_to_die>=10
actions.cleave+=/mind_flay,if=target.time_to_die>=cast_time*0.5&!moving&active_enemies>=3
actions.cleave+=/mind_flay,interrupt_if=!buff.inner_focus.up&ticks>=2,if=target.time_to_die>=cast_time&!moving
actions.cleave+=/shadow_word_death,if=moving
actions.cleave+=/devouring_plague,if=moving
actions.cleave+=/shadowfiend,if=mana.percent<=60

## Single
actions.single+=/devouring_plague,if=target.time_to_die<=action.mind_flay.duration|(moving&!dot.devouring_plague.remains)
actions.single+=/mind_flay,if=buff.inner_focus.up|(dot.shadow_word_pain.remains<1.5&dot.shadow_word_pain.remains>=action.mind_flay.tick_time+latency)
actions.single+=/shadowfiend,if=target.time_to_die>0
actions.single+=/shadow_word_pain,if=!ticking&((buff.shadow_weaving.stack=5&target.time_to_die>=75)|(buff.shadow_weaving.stack>=3&target.time_to_die<75))
actions.single+=/vampiric_touch,if=dot.vampiric_touch.remains+latency<cast_time&target.time_to_die>=3
actions.single+=/devouring_plague,if=!dot.devouring_plague.remains
actions.single+=/mind_blast,if=target.time_to_die>=cast_time&(flay_over_blast|buff.replenishment.remains<3)
actions.single+=/inner_focus,if=buff.shadow_weaving.stack=5
actions.single+=/wait,if=dot.devouring_plague.remains<=0.2,sec=dot.devouring_plague.remains
actions.single+=/wait,if=dot.vampiric_touch.ticking&action.mind_flay.channeling&dot.vampiric_touch.remains<=(action.vampiric_touch.cast_time+latency),sec=(dot.vampiric_touch.remains-action.vampiric_touch.cast_time)
actions.single+=/inner_fire,if=!buff.inner_fire.up&target.time_to_die>=10
actions.single+=/vampiric_embrace,if=!up&target.time_to_die>=10
actions.single+=/mind_flay,interrupt_if=!buff.inner_focus.up&ticks>=2,if=!moving
actions.single+=/shadow_word_death,if=moving
actions.single+=/devouring_plague,if=moving
actions.single+=/shadowfiend,if=mana.percent<=60
