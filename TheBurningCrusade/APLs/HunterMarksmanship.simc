actions.precombat+=/aspect_of_the_hawk
actions.precombat+=/hunters_mark,if=down
actions+=/run_action_list,name=aoe,if=active_enemies>=2
actions+=/run_action_list,name=st

actions.st+=/auto_shot,if=action.aspect_of_the_viper.time_since<6&buff.aspect_of_the_viper.up&cooldown.arcane_shot.remains>0
actions.st+=/aspect_of_the_hawk,if=down&mana.percent>25
actions.st+=/hunters_mark,if=down
actions.st+=/rapid_fire,if=buff.rapid_fire.down
actions.st+=/bestial_wrath,if=buff.bestial_wrath.down
actions.st+=/potion
actions.st+=/use_items
actions.st+=/arcane_shot
actions.st+=/serpent_sting,if=debuff.stings.down
actions.st+=/arcane_shot
actions.st+=/aimed_shot
actions.st+=/readiness,if=(cooldown.rapid_fire.remains>=150|cooldown.rapid_fire.remains>target.time_to_die)&cooldown.arcane_shot.remains>0&cooldown.aimed_shot.remains>0
actions.st+=/arcane_shot
actions.st+=/explosive_trap,if=settings.suggest_explosive_st
actions.st+=/aspect_of_the_viper,if=settings.manage_mana_viper&mana.percent<=25
actions.st+=/auto_shot

actions.aoe+=/explosive_trap,if=target.within5
actions.aoe+=/multi_shot
actions.aoe+=/volley,if=active_enemies>=3
actions.aoe+=/serpent_sting,if=debuff.stings.down
actions.aoe+=/arcane_shot