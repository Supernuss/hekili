actions.precombat+=/windfury_weapon,if=!mainhand_imbued
actions.precombat+=/windfury_weapon,if=!offhand_imbued
actions.precombat+=/lightning_shield,if=buff.shield.down
actions.precombat+=/strength_of_earth_totem,if=buff.earth_totem.down
actions.precombat+=/grace_of_air_totem,if=buff.air_totem.down
actions.precombat+=/healing_stream_totem,if=buff.water_totem.down
actions.precombat+=/searing_totem,if=buff.fire_totem.down

actions+=/windfury_weapon,if=!mainhand_imbued
actions+=/windfury_weapon,if=!offhand_imbued
actions+=/lightning_shield,if=buff.shield.down
actions+=/stoneclaw_totem,if=active_enemies>1&buff.earth_totem.down
actions+=/strength_of_earth_totem,if=active_enemies<=1&buff.earth_totem.remains<=latency
actions+=/grace_of_air_totem,if=buff.air_totem.remains<=latency
actions+=/healing_stream_totem,if=buff.water_totem.remains<=latency
actions+=/searing_totem,if=active_enemies<=1&buff.fire_totem.remains<=latency
actions+=/magma_totem,if=active_enemies>1&buff.fire_totem.remains<=latency
actions+=/fire_nova_totem,if=active_enemies>1&buff.magma_totem.up
actions+=/shamanistic_rage
actions+=/lightning_bolt,if=!target.within10&mana.pct>=40
actions+=/lightning_bolt,rank=1,if=!target.within10&mana.pct<40
actions+=/stormstrike,if=buff.stormstrike.down
actions+=/flame_shock,if=!ticking&target.time_to_die>=12
actions+=/earth_shock,if=dot.flame_shock.ticking|target.time_to_die<12
actions+=/stormstrike
