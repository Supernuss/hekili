actions.precombat+=/flametongue_weapon,if=!mainhand_imbued
actions.precombat+=/water_shield,if=buff.shield.down
actions.precombat+=/wrath_of_air_totem,if=buff.air_totem.down
actions.precombat+=/totem_of_wrath,if=talent.totem_of_wrath.enabled&buff.fire_totem.down
actions.precombat+=/searing_totem,if=!talent.totem_of_wrath.enabled&buff.fire_totem.down
actions.precombat+=/potion

actions+=/flametongue_weapon,if=!mainhand_imbued
actions+=/water_shield,if=buff.shield.down
actions+=/wrath_of_air_totem,if=buff.air_totem.remains<=latency
actions+=/totem_of_wrath,if=talent.totem_of_wrath.enabled&buff.fire_totem.remains<=latency
actions+=/searing_totem,if=!talent.totem_of_wrath.enabled&active_enemies<3&buff.fire_totem.remains<=latency
actions+=/magma_totem,if=active_enemies>=3&buff.fire_totem.remains<=latency&buff.fire_elemental_totem.down
actions+=/fire_nova_totem,if=active_enemies>=3&buff.magma_totem.up
actions+=/totem_of_wrath,if=target.time_to_die>120
actions+=/bloodlust,if=target.time_to_die>40
actions+=/use_items
actions+=/potion
actions+=/elemental_mastery,if=!moving&(active_enemies>=2|target.time_to_die<20)
actions+=/natures_swiftness,if=talent.natures_swiftness.enabled&(moving|target.time_to_die<10)
actions+=/chain_lightning,if=active_enemies>=2
actions+=/flame_shock,if=!ticking&target.time_to_die>=12
actions+=/earth_shock,if=dot.flame_shock.ticking|target.time_to_die<12
actions+=/lightning_bolt