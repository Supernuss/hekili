actions.precombat+=/aspect_of_the_hawk,if=buff.aspect_of_the_hawk.down
actions.precombat+=/potion

actions+=/use_items,use_off_gcd=true
actions+=/potion,use_off_gcd=true
actions+=/aspect_of_the_viper,if=mana.pct<=settings.hunter_sv_viper_swap_to_viper_pct&buff.aspect_of_the_viper.down
actions+=/aspect_of_the_hawk,if=mana.pct>=settings.hunter_sv_viper_swap_to_hawk_pct&buff.aspect_of_the_hawk.down
actions+=/rapid_fire
actions+=/kill_command
actions+=/raptor_strike,if=settings.hunter_sv_weave_raptor&active_enemies<=1&cooldown.auto_shot.remains>gcd.remains&target.time_to_die>15
actions+=/auto_shot,if=cooldown.auto_shot.remains<=gcd.remains|mana.pct<=settings.hunter_sv_viper_swap_to_viper_pct
actions+=/multi_shot,if=cooldown.auto_shot.remains>gcd.remains
actions+=/arcane_shot,if=cooldown.auto_shot.remains>gcd.remains
actions+=/auto_shot