actions.precombat+=/stealth
actions.precombat+=/potion

actions+=/use_items,use_off_gcd=true
actions+=/potion,use_off_gcd=true
actions+=/kick,use_off_gcd=true
actions+=/shiv,if=debuff.deadly_poison.up&debuff.deadly_poison.remains<settings.rogue_deadly_poison_refresh
actions+=/slice_and_dice,if=buff.slice_and_dice.down&combo_points.current>=settings.rogue_snd_start_cp
actions+=/expose_armor,if=settings.maintain_expose&combo_points.current=5&(!debuff.major_armor_reduction.up|debuff.expose_armor.remains<settings.rogue_expose_urgent_remains)
actions+=/slice_and_dice,if=buff.slice_and_dice.remains<settings.rogue_snd_refresh&combo_points.current>=settings.rogue_snd_start_cp
actions+=/expose_armor,if=settings.maintain_expose&combo_points.current=5&debuff.expose_armor.remains<settings.rogue_expose_pool_remains&energy.current>=settings.rogue_pool_energy
actions+=/slice_and_dice,if=combo_points.current=5&buff.slice_and_dice.remains<settings.rogue_snd_pool_window&energy.current>=settings.rogue_pool_energy
actions+=/rupture,if=combo_points.current>=settings.rogue_rupture_min_cp&!dot.rupture.ticking&target.time_to_die>=settings.rogue_rupture_ttd&buff.slice_and_dice.remains>settings.rogue_finisher_snd_gate&(!settings.maintain_expose|debuff.expose_armor.remains>settings.rogue_finisher_expose_gate|!debuff.major_armor_reduction.up)&(active_enemies<2|!buff.blade_flurry.up)
actions+=/envenom,if=combo_points.current>=settings.rogue_execute_min_cp&target.time_to_die<settings.rogue_execute_ttd
actions+=/envenom,if=combo_points.current=5&debuff.deadly_poison.up&buff.slice_and_dice.remains>settings.rogue_finisher_snd_gate&(!settings.maintain_expose|debuff.expose_armor.remains>settings.rogue_finisher_expose_gate|!debuff.major_armor_reduction.up)
actions+=/mutilate,if=combo_points.current<5