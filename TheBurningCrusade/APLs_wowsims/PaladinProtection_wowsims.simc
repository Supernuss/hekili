actions.precombat+=/blessing_of_kings,if=buff.blessing_of_kings.down
actions.precombat+=/righteous_fury,if=buff.righteous_fury.down
actions.precombat+=/retribution_aura,if=buff.retribution_aura.down
actions.precombat+=/seal_of_righteousness,if=buff.seal_of_righteousness.down

actions+=/use_items,use_off_gcd=1
actions+=/potion,use_off_gcd=1
actions+=/seal_of_wisdom,if=debuff.judgement_of_wisdom.down&cooldown.judgement_of_wisdom.ready&buff.seal_of_wisdom.down
actions+=/judgement_of_wisdom,if=buff.seal_of_wisdom.up
actions+=/seal_of_wisdom,if=debuff.judgement_of_wisdom.down&buff.seal_of_wisdom.down&!cooldown.judgement_of_wisdom.ready
actions+=/seal_of_righteousness,if=buff.seal_of_wisdom.down&buff.seal_of_righteousness.down
actions+=/consecration
actions+=/judgement_of_righteousness,if=buff.seal_of_righteousness.up
actions+=/seal_of_righteousness,if=buff.seal_of_righteousness.down
actions+=/exorcism,if=mana.pct>settings.paladin_prot_exorcism_mana
actions+=/holy_shield,if=buff.holy_shield.down