actions.precombat+=/cat_form,if=buff.cat_form.down
actions.precombat+=/mark_of_the_wild,if=buff.mark_of_the_wild.down
actions.precombat+=/thorns,if=buff.thorns.down

actions+=/cat_form,if=buff.cat_form.down
actions+=/faerie_fire_feral,if=debuff.faerie_fire_feral.remains<3
actions+=/rip,if=wowsim_druid_feral_shifted_rip
actions+=/mangle_cat,if=wowsim_druid_feral_shifted_mangle
actions+=/ferocious_bite,if=wowsim_druid_feral_shifted_bite
actions+=/shred,if=wowsim_druid_feral_shifted_shred
actions+=/rip,if=combo_points.current>=5&!dot.rip.ticking&target.time_to_die>=wowsim_feral_rip_end_thresh
actions+=/ferocious_bite,if=wowsim_druid_feral_bite_execute
actions+=/ferocious_bite,if=wowsim_druid_feral_bite_rip_mangle
actions+=/mangle_cat,if=debuff.mangle.remains<1.5
actions+=/mangle_cat,if=wowsim_druid_feral_mangle_weave_window
actions+=/shred,if=buff.clearcasting.up
actions+=/shred,if=energy.current>=42
actions+=/mangle_cat,if=wowsim_druid_feral_mangle_builder
actions+=/cat_form,if=wowsim_druid_feral_powershift_rip
actions+=/cat_form,if=wowsim_druid_feral_powershift_low_energy