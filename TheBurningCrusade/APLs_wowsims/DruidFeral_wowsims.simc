actions.precombat+=/cat_form,if=buff.cat_form.down
actions.precombat+=/mark_of_the_wild,if=buff.mark_of_the_wild.down
actions.precombat+=/thorns,if=buff.thorns.down

actions+=/cat_form,if=buff.cat_form.down
actions+=/faerie_fire_feral,if=debuff.faerie_fire_feral.remains<3
actions+=/variable,name=shifted,op=set,value=mana.current<action.cat_form.spend
actions+=/rip,if=variable.shifted&combo_points.current>=5&!dot.rip.ticking&(energy.current>=30|buff.clearcasting.up)&target.time_to_die>=settings.feral_rip_end_thresh
actions+=/mangle_cat,if=variable.shifted&debuff.mangle.remains<1.5&(energy.current>=action.mangle_cat.spend|buff.clearcasting.up)
actions+=/ferocious_bite,if=variable.shifted&combo_points.current>=5&(energy.current>=35|buff.clearcasting.up)
actions+=/shred,if=variable.shifted&(energy.current>=42|buff.clearcasting.up)
actions+=/rip,if=combo_points.current>=5&!dot.rip.ticking&target.time_to_die>=settings.feral_rip_end_thresh
actions+=/ferocious_bite,if=combo_points.current>=5&(target.time_to_die<settings.feral_rip_end_thresh|(dot.rip.ticking&dot.rip.remains<settings.feral_rip_end_thresh))
actions+=/ferocious_bite,if=combo_points.current>=5&dot.rip.ticking&debuff.mangle.remains>=1.5&energy.current>=35
actions+=/mangle_cat,if=debuff.mangle.remains<1.5
actions+=/mangle_cat,if=energy.current>=2*action.mangle_cat.spend-20&energy.current<22+action.mangle_cat.spend&energy.time_to_max<=1
actions+=/shred,if=buff.clearcasting.up
actions+=/shred,if=energy.current>=42
actions+=/mangle_cat,if=energy.current>=action.mangle_cat.spend&energy.time_to_max>1
actions+=/cat_form,if=equipped.wolfshead_helm&energy.current<action.mangle_cat.spend-20&dot.rip.remains<settings.feral_rip_end_thresh&mana.current>=action.cat_form.spend
actions+=/cat_form,if=equipped.wolfshead_helm&energy.current<10&mana.current>=action.cat_form.spend