actions.precombat+=/moonkin_form,if=buff.moonkin_form.down
actions.precombat+=/mark_of_the_wild,if=buff.mark_of_the_wild.down
actions.precombat+=/thorns,if=buff.thorns.down

actions+=/faerie_fire,if=settings.balance_use_faerie_fire&debuff.faerie_fire.remains<3
actions+=/hurricane,if=settings.balance_use_hurricane
actions+=/insect_swarm,if=settings.balance_use_insect_swarm&!dot.insect_swarm.ticking
actions+=/moonfire,if=settings.balance_use_moonfire&!dot.moonfire.ticking
actions+=/wrath,if=settings.balance_primary_wrath
actions+=/starfire