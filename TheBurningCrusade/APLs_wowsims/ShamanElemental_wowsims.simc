actions.precombat+=/wrath_of_air_totem,if=settings.shaman_ele_maintain_air_totem&totem.air.down
actions.precombat+=/mana_spring_totem,if=settings.shaman_ele_maintain_water_totem&totem.water.down
actions.precombat+=/totem_of_wrath,if=settings.shaman_ele_maintain_fire_totem&totem.fire.down
actions.precombat+=/potion

actions+=/use_items,use_off_gcd=1
actions+=/potion,use_off_gcd=1
actions+=/bloodlust
actions+=/elemental_mastery
actions+=/tremor_totem,if=settings.shaman_ele_maintain_earth_totem&totem.earth.down
actions+=/wrath_of_air_totem,if=settings.shaman_ele_maintain_air_totem&totem.air.down
actions+=/mana_spring_totem,if=settings.shaman_ele_maintain_water_totem&totem.water.down
actions+=/totem_of_wrath,if=settings.shaman_ele_maintain_fire_totem&totem.fire.down
actions+=/chain_lightning,if=active_enemies>=settings.shaman_ele_chain_lightning_aoe
