actions.precombat+=/battle_stance
actions.precombat+=/battle_shout,if=buff.battle_shout.down
actions.precombat+=/bloodrage

actions+=/use_items,use_off_gcd=true
actions+=/recklessness,if=target.time_to_die>20
actions+=/battle_shout,if=buff.battle_shout.down
actions+=/demoralizing_shout,if=debuff.demoralizing_shout.remains<2
actions+=/thunder_clap,if=debuff.thunder_clap.remains<2
actions+=/mortal_strike,if=target.health.pct<=20&settings.warrior_arms_use_ms_execute
actions+=/whirlwind,if=target.health.pct<=20&settings.warrior_arms_use_ww_execute
actions+=/slam,if=target.health.pct<=20&settings.warrior_arms_use_slam_execute&rage.current>=settings.warrior_arms_slam_min_rage&cooldown.mortal_strike.remains>=settings.warrior_arms_slam_msww_delay&cooldown.whirlwind.remains>=settings.warrior_arms_slam_msww_delay
actions+=/execute,if=target.health.pct<=20
actions+=/berserker_rage,if=target.health.pct<=20&buff.berserker_rage.down
actions+=/mortal_strike,if=target.health.pct>20
actions+=/whirlwind,if=target.health.pct>20
actions+=/overpower,if=target.health.pct>20&buff.overpower_ready.up&rage.current<settings.warrior_arms_overpower_rage_threshold
actions+=/berserker_rage,if=target.health.pct>20&buff.berserker_rage.down
actions+=/hamstring,if=target.health.pct>20&rage.current>=settings.warrior_arms_hamstring_rage_threshold&debuff.hamstring.remains<2
actions+=/slam,if=target.health.pct>20&rage.current>=settings.warrior_arms_slam_min_rage&cooldown.mortal_strike.remains>=settings.warrior_arms_slam_msww_delay&cooldown.whirlwind.remains>=settings.warrior_arms_slam_msww_delay
actions+=/heroic_strike,if=rage.current>=settings.warrior_arms_hs_rage_threshold&(target.health.pct>20|settings.warrior_arms_use_hs_execute)