actions.precombat+=/battle_stance
actions.precombat+=/battle_shout,if=buff.battle_shout.down
actions.precombat+=/bloodrage

actions+=/use_items,use_off_gcd=1
actions+=/recklessness,if=target.time_to_die>20
actions+=/battle_shout,if=buff.battle_shout.down
actions+=/demoralizing_shout,if=debuff.demoralizing_shout.remains<2
actions+=/thunder_clap,if=debuff.thunder_clap.remains<2
actions+=/mortal_strike,if=wowsim_warrior_arms_ms_execute_condition
actions+=/whirlwind,if=wowsim_warrior_arms_ww_execute_condition
actions+=/slam,if=wowsim_warrior_arms_slam_execute_condition
actions+=/execute,if=wowsim_warrior_arms_execute_phase
actions+=/berserker_rage,if=wowsim_warrior_arms_execute_phase&buff.berserker_rage.down
actions+=/mortal_strike,if=wowsim_warrior_arms_non_execute_phase
actions+=/whirlwind,if=wowsim_warrior_arms_non_execute_phase
actions+=/overpower,if=wowsim_warrior_arms_overpower_condition
actions+=/berserker_rage,if=wowsim_warrior_arms_non_execute_phase&buff.berserker_rage.down
actions+=/hamstring,if=wowsim_warrior_arms_hamstring_condition
actions+=/slam,if=wowsim_warrior_arms_slam_non_execute_condition
actions+=/heroic_strike,if=wowsim_warrior_arms_hs_condition