actions.precombat+=/berserker_stance
actions.precombat+=/battle_shout,if=buff.battle_shout.down
actions.precombat+=/bloodrage

actions+=/use_items,use_off_gcd=true
actions+=/recklessness,if=target.time_to_die>20
actions+=/death_wish
actions+=/battle_shout,if=buff.battle_shout.down
actions+=/rampage,if=buff.rampage.remains<=settings.warrior_fury_rampage_cd_threshold
actions+=/bloodthirst,if=target.health.pct<=20&settings.warrior_fury_use_bt_execute
actions+=/whirlwind,if=target.health.pct<=20&settings.warrior_fury_use_ww_execute
actions+=/execute,if=target.health.pct<=20
actions+=/berserker_rage,if=target.health.pct<=20&buff.berserker_rage.down
actions+=/bloodthirst,if=target.health.pct>20
actions+=/whirlwind,if=target.health.pct>20
actions+=/overpower,if=target.health.pct>20&buff.overpower_ready.up&rage.current<settings.warrior_fury_overpower_rage_threshold
actions+=/berserker_rage,if=target.health.pct>20&buff.berserker_rage.down
actions+=/hamstring,if=target.health.pct>20&rage.current>=settings.warrior_fury_hamstring_rage_threshold&debuff.hamstring.remains<2
actions+=/cleave,if=active_enemies>=2&rage.current>=settings.warrior_fury_hs_rage_threshold&(target.health.pct>20|settings.warrior_fury_use_hs_execute)
actions+=/heroic_strike,if=active_enemies<2&rage.current>=settings.warrior_fury_hs_rage_threshold&(target.health.pct>20|settings.warrior_fury_use_hs_execute)