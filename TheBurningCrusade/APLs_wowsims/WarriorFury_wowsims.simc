actions.precombat+=/berserker_stance
actions.precombat+=/battle_shout,if=buff.battle_shout.down
actions.precombat+=/bloodrage

actions+=/use_items,use_off_gcd=1
actions+=/recklessness,if=target.time_to_die>20
actions+=/death_wish
actions+=/battle_shout,if=buff.battle_shout.down
actions+=/rampage,if=buff.rampage.remains<=wowsim_warrior_fury_rampage_cd_threshold
actions+=/bloodthirst,if=wowsim_warrior_fury_bt_execute_condition
actions+=/whirlwind,if=wowsim_warrior_fury_ww_execute_condition
actions+=/execute,if=wowsim_warrior_fury_execute_phase
actions+=/berserker_rage,if=wowsim_warrior_fury_execute_phase&buff.berserker_rage.down
actions+=/bloodthirst,if=wowsim_warrior_fury_non_execute_phase
actions+=/whirlwind,if=wowsim_warrior_fury_non_execute_phase
actions+=/overpower,if=wowsim_warrior_fury_overpower_condition
actions+=/berserker_rage,if=wowsim_warrior_fury_non_execute_phase&buff.berserker_rage.down
actions+=/hamstring,if=wowsim_warrior_fury_hamstring_condition
actions+=/cleave,if=wowsim_warrior_fury_cleave_condition
actions+=/heroic_strike,if=wowsim_warrior_fury_hs_condition