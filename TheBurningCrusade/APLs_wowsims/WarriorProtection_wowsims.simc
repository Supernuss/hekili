actions.precombat+=/defensive_stance
actions.precombat+=/commanding_shout,if=buff.commanding_shout.down
actions.precombat+=/battle_shout,if=buff.commanding_shout.down&buff.battle_shout.down
actions.precombat+=/bloodrage

actions+=/use_items,use_off_gcd=true
actions+=/shield_slam
actions+=/bloodthirst
actions+=/mortal_strike
actions+=/revenge
actions+=/commanding_shout,if=buff.commanding_shout.down
actions+=/battle_shout,if=buff.commanding_shout.down&buff.battle_shout.down
actions+=/thunder_clap,if=settings.warrior_prot_thunder_mode_maintain&debuff.thunder_clap.remains<2
actions+=/thunder_clap,if=settings.warrior_prot_thunder_mode_on_cd
actions+=/demoralizing_shout,if=settings.warrior_prot_demo_mode_maintain&debuff.demoralizing_shout.remains<2
actions+=/demoralizing_shout,if=settings.warrior_prot_demo_mode_filler
actions+=/devastate
actions+=/sunder_armor
actions+=/shield_block,if=settings.warrior_prot_shield_block_on_cd&buff.shield_block.down
actions+=/shield_block,if=settings.warrior_prot_shield_block_revenge&cooldown.revenge.ready&buff.shield_block.down
actions+=/cleave,if=active_enemies>=2&rage.current>=settings.warrior_prot_hs_rage_threshold
actions+=/heroic_strike,if=active_enemies<2&rage.current>=settings.warrior_prot_hs_rage_threshold