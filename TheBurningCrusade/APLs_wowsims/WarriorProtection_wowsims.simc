actions.precombat+=/defensive_stance
actions.precombat+=/commanding_shout,if=buff.commanding_shout.down
actions.precombat+=/battle_shout,if=buff.commanding_shout.down&buff.battle_shout.down
actions.precombat+=/bloodrage

actions+=/use_items,use_off_gcd=1
actions+=/shield_slam
actions+=/bloodthirst
actions+=/mortal_strike
actions+=/revenge
actions+=/commanding_shout,if=buff.commanding_shout.down
actions+=/battle_shout,if=buff.commanding_shout.down&buff.battle_shout.down
actions+=/thunder_clap,if=wowsim_warrior_prot_thunder_maintain_condition
actions+=/thunder_clap,if=wowsim_warrior_prot_thunder_on_cd_condition
actions+=/demoralizing_shout,if=wowsim_warrior_prot_demo_maintain_condition
actions+=/demoralizing_shout,if=wowsim_warrior_prot_demo_filler_condition
actions+=/devastate
actions+=/sunder_armor
actions+=/shield_block,if=wowsim_warrior_prot_shield_block_on_cd_condition
actions+=/shield_block,if=wowsim_warrior_prot_shield_block_revenge_condition
actions+=/cleave,if=wowsim_warrior_prot_cleave_condition
actions+=/heroic_strike,if=wowsim_warrior_prot_hs_condition