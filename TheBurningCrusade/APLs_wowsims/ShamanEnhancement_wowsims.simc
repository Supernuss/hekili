actions.precombat+=/windfury_weapon,if=buff.windfury_weapon.down
actions.precombat+=/flametongue_weapon,if=buff.flametongue_weapon.down
actions.precombat+=/strength_of_earth_totem,if=wowsim_shaman_enh_maintain_earth_totem
actions.precombat+=/grace_of_air_totem,if=wowsim_shaman_enh_maintain_air_totem
actions.precombat+=/mana_spring_totem,if=wowsim_shaman_enh_maintain_water_totem
actions.precombat+=/magma_totem,if=wowsim_shaman_enh_maintain_fire_totem

actions+=/use_items,use_off_gcd=1
actions+=/potion,use_off_gcd=1
actions+=/bloodlust
actions+=/shamanistic_rage,if=wowsim_shaman_enh_shamanistic_rage_mana
actions+=/stormstrike
actions+=/flame_shock,if=wowsim_shaman_enh_flame_shock_refresh
actions+=/earth_shock
actions+=/fire_nova_totem,if=wowsim_shaman_enh_fire_nova_mana
actions+=/magma_totem,if=wowsim_shaman_enh_maintain_fire_totem
actions+=/strength_of_earth_totem,if=wowsim_shaman_enh_maintain_earth_totem
actions+=/windfury_totem,if=wowsim_shaman_enh_maintain_air_totem
actions+=/grace_of_air_totem,if=wowsim_shaman_enh_maintain_air_totem
actions+=/mana_spring_totem,if=wowsim_shaman_enh_maintain_water_totem