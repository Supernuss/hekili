actions.precombat+=/windfury_weapon,if=buff.windfury_weapon.down
actions.precombat+=/flametongue_weapon,if=buff.flametongue_weapon.down
actions.precombat+=/strength_of_earth_totem,if=settings.shaman_enh_maintain_earth_totem&totem.earth.down
actions.precombat+=/grace_of_air_totem,if=settings.shaman_enh_maintain_air_totem&totem.air.down
actions.precombat+=/mana_spring_totem,if=settings.shaman_enh_maintain_water_totem&totem.water.down
actions.precombat+=/magma_totem,if=settings.shaman_enh_maintain_fire_totem&totem.fire.down

actions+=/use_items,use_off_gcd=1
actions+=/potion,use_off_gcd=1
actions+=/bloodlust
actions+=/variable,name=shaman_enh_shock_mana_reserve,op=set,value=max(action.earth_shock.spend,action.flame_shock.spend)
actions+=/variable,name=shaman_enh_shamanistic_rage_floor,op=set,value=max(action.shamanistic_rage.spend+variable.shaman_enh_shock_mana_reserve,mana.max*settings.shaman_enh_shamanistic_rage_mana*0.01)
actions+=/variable,name=shaman_enh_fire_nova_floor,op=set,value=action.fire_nova_totem.spend+variable.shaman_enh_shock_mana_reserve+action.stormstrike.spend
actions+=/shamanistic_rage,if=mana.current<=variable.shaman_enh_shamanistic_rage_floor
actions+=/stormstrike
actions+=/flame_shock,if=settings.shaman_enh_flame_shock_refresh&!dot.flame_shock.ticking
actions+=/earth_shock
actions+=/fire_nova_totem,if=active_enemies>=settings.shaman_enh_fire_nova_min_targets&buff.magma_totem.up&mana.current>=variable.shaman_enh_fire_nova_floor
actions+=/magma_totem,if=settings.shaman_enh_maintain_fire_totem&totem.fire.down
actions+=/strength_of_earth_totem,if=settings.shaman_enh_maintain_earth_totem&totem.earth.down
actions+=/windfury_totem,if=settings.shaman_enh_maintain_air_totem&totem.air.down
actions+=/grace_of_air_totem,if=settings.shaman_enh_maintain_air_totem&totem.air.down
actions+=/mana_spring_totem,if=settings.shaman_enh_maintain_water_totem&totem.water.down