actions.precombat+=/shadowform,if=buff.shadowform.down
actions.precombat+=/divine_spirit,if=buff.divine_spirit.down&buff.prayer_of_spirit.down
actions.precombat+=/power_word_fortitude,if=buff.power_word_fortitude.down&buff.prayer_of_fortitude.down
actions.precombat+=/inner_fire,if=buff.inner_fire.down
actions.precombat+=/vampiric_embrace,if=buff.vampiric_embrace.down
actions.precombat+=/vampiric_touch,if=settings.shadow_precast_vampiric_touch
actions.precombat+=/potion

actions+=/variable,name=next_nuke_cd,op=set,value=min(cooldown.mind_blast.remains,cooldown.shadow_word_death.remains)
actions+=/use_items,use_off_gcd=1
actions+=/potion,use_off_gcd=1
actions+=/vampiric_touch,if=dot.vampiric_touch.remains<=action.vampiric_touch.cast_time
actions+=/shadow_word_pain,if=!dot.shadow_word_pain.ticking
actions+=/starshards,if=settings.shadow_use_starshards&cooldown.starshards.remains=0
actions+=/devouring_plague,if=settings.shadow_use_devouring_plague&cooldown.devouring_plague.remains=0
actions+=/mind_blast,if=cooldown.mind_blast.remains=0
actions+=/shadow_word_death,if=cooldown.shadow_word_death.remains=0
actions+=/mind_flay,interrupt_if=ticks>=1,if=variable.next_nuke_cd>=gcd&variable.next_nuke_cd<action.mind_flay.tick_time*2+settings.shadow_mind_flay_clip_latency
actions+=/mind_flay,interrupt_if=ticks>=2,if=variable.next_nuke_cd>=gcd&(variable.next_nuke_cd<action.mind_flay.tick_time*3+settings.shadow_mind_flay_clip_latency|variable.next_nuke_cd>=action.mind_flay.tick_time*4+settings.shadow_mind_flay_clip_latency&variable.next_nuke_cd<action.mind_flay.tick_time*5+settings.shadow_mind_flay_clip_latency)
actions+=/mind_flay,if=variable.next_nuke_cd>=gcd