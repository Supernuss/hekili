actions.precombat+=/aspect_of_the_hawk,if=buff.aspect_of_the_hawk.down
actions.precombat+=/aimed_shot,if=talent.aimed_shot.enabled
actions.precombat+=/potion

actions+=/use_items,use_off_gcd=true
actions+=/potion,use_off_gcd=true
actions+=/aspect_of_the_viper,if=mana.pct<=settings.hunter_bm_viper_swap_to_viper_pct&buff.aspect_of_the_viper.down
actions+=/aspect_of_the_hawk,if=mana.pct>=settings.hunter_bm_viper_swap_to_hawk_pct&buff.aspect_of_the_hawk.down
actions+=/serpent_sting,if=!dot.serpent_sting.ticking
actions+=/bestial_wrath
actions+=/rapid_fire
actions+=/kill_command
actions+=/auto_shot,if=cooldown.auto_shot.remains<=gcd.remains|mana.pct<=settings.hunter_bm_viper_swap_to_viper_pct
actions+=/multi_shot,if=cooldown.auto_shot.remains>gcd.remains
actions+=/auto_shot